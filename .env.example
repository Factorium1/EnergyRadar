# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real credentials.
#
# This file holds env vars shared across all workspaces (apps/*, packages/*)
# so they can't drift out of sync. App-specific values (e.g. PORT) still
# live in each workspace's own .env file.

# PostgreSQL connection string used by Prisma.
# See https://pris.ly/d/connection-strings for all options.
DATABASE_URL=postgresql://user:password@localhost:5432/energyradar
