{
  "name": "@energyradar/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "catalog:db",
    "@prisma/client": "catalog:db",
    "dotenv": "catalog:",
    "pg": "catalog:db"
  },
  "devDependencies": {
    "@energyradar/eslint-config": "workspace:*",
    "@energyradar/ts-config": "workspace:*",
    "@energyradar/vitest-config": "workspace:*",
    "@types/node": "catalog:core",
    "@types/pg": "catalog:db",
    "@vitest/coverage-v8": "catalog:test",
    "eslint": "catalog:lint",
    "prisma": "catalog:db",
    "tsx": "catalog:core",
    "typescript": "catalog:core",
    "vitest": "catalog:test"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
