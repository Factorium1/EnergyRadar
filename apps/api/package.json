{
  "name": "@energyradar/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@energyradar/db": "workspace:*",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:"
  },
  "devDependencies": {
    "@energyradar/eslint-config": "workspace:*",
    "@energyradar/ts-config": "workspace:*",
    "@energyradar/vitest-config": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:core",
    "@vitest/coverage-v8": "catalog:test",
    "eslint": "catalog:lint",
    "pino-pretty": "catalog:",
    "tsx": "catalog:core",
    "typescript": "catalog:core",
    "vitest": "catalog:test"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
